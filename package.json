{
  "name": "stillharbour",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "node scripts/tauri.mjs",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:build": "npm run tauri -- build --bundles app",
    "desktop:test:build": "npm run tauri -- build --debug --no-bundle --features desktop-test --config src-tauri/tauri.test.conf.json",
    "desktop:test": "wdio run wdio.conf.mjs",
    "desktop:test:formats": "wdio run wdio.formats.conf.mjs",
    "formats:build": "node scripts/cargo.mjs build --locked --release -p stillharbour-core --features fixture-probes --example format_probe",
    "formats:test": "python3 scripts/formats/run.py",
    "bindings": "node scripts/cargo.mjs run --locked -p stillharbour-core --example export_bindings --",
    "bindings:check": "npm run bindings -- --check",
    "rust:check": "node scripts/rust-check.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run bindings:check && npm run rust:check && npm run build",
    "fixtures:smoke": "node scripts/cargo.mjs run -p stillharbour-core --features fixture-probes --example foundation_probe",
    "media:smoke": "node scripts/media-smoke.mjs",
    "release:check": "node scripts/release-check.mjs",
    "perf:catalog:build": "node scripts/cargo.mjs build --locked --release -p stillharbour-core --features fixture-probes --example performance_probe",
    "perf:catalog": "python3 scripts/performance/run.py",
    "perf:p1": "python3 scripts/performance/run.py --phase p1",
    "perf:desktop": "wdio run wdio.performance.conf.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.23",
    "@tauri-apps/api": "2.12.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "overrides": {
    "basic-ftp": "6.2.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@wdio/cli": "10.1.0",
    "@wdio/globals": "10.1.0",
    "@wdio/local-runner": "10.1.0",
    "@wdio/mocha-framework": "10.1.0",
    "@wdio/spec-reporter": "10.1.0",
    "@wdio/tauri-plugin": "1.5.1",
    "@wdio/tauri-service": "1.5.1",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
