  "narrative": {
    "northStar": "Photo canvas inside the native workspace",
    "overview": "Stillharbour is an Operate workspace: photographs lead, while cool neutral surfaces, compact Inter text and precise controls support browsing and review. The unchanged multicolour owner aperture is the identity; ordinary actions and selected states stay neutral. First-run setup remains spacious, while galleries, utilities and Settings use the density their tasks require.\n\nThis code-led refresh records the delivered 2026-11-07 redesign. It supersedes conflicting dated charcoal/sage, system-only typography, four-pixel gutter, header and navigation instructions from the previous DESIGN.md. Functional contracts and preservation gates remain in the product documentation. Source authority is `src/theme/` and the owning components; [NEUTRAL_UI.md](docs/NEUTRAL_UI.md) records implementation scope and validation limits. Native gallery captures in `.context/redesign-native/screenshots/` show both appearances at 1180×780 and 660×560; generated media and preparing-preview states are test evidence, not product artwork or a bundled library.",
    "keyCharacteristics": [
      "Photographs and the unchanged owner mark carry colour; interface state uses cool neutrals.",
      "Bundled Inter Variable and tabular numbers keep compact controls and data aligned.",
      "Six-pixel gallery gutters, real date context and restrained final rows preserve image rhythm.",
      "Loading, unavailable, offline, selected and failed states remain explicit.",
      "Chakra semantic tokens cover document, native controls and portalled surfaces in both appearances."
    ],
    "rules": [
      {
        "name": "The Neutral Frame Rule",
        "body": "Keep ordinary chrome, focus and selection neutral; reserve prism hues for small colour-label indicators and preserve the original logo fills.",
        "section": "colors"
      },
      {
        "name": "The State Has Words Rule",
        "body": "Selection, availability, job progress and errors need textual or semantic states alongside colour.",
        "section": "colors"
      },
      {
        "name": "The Owned Styles Rule",
        "body": "Keep component styling in Chakra props, css objects and colocated recipes; keep global theme styles limited to document/native defaults and shared keyframes.",
        "section": "components"
      }
    ],
    "dos": [
      "**Do** preserve Stillharbour’s British spelling and the unchanged owner SVG.",
      "**Do** use semantic neutral tokens across both appearances, including portals and native controls.",
      "**Do** keep six-pixel gallery geometry and virtual extents in agreement, preserving the visible photo anchor.",
      "**Do** preserve keyboard focus, explicit selection scopes, retryable failures and return focus after dialogs/viewing.",
      "**Do** distinguish catalog edits, cached previews, accessible originals and independently proven recovery.",
      "**Do** reuse shared control recipes and keep component-specific styles beside their owner."
    ],
    "donts": [
      "**Don’t** restore the superseded sage palette, system-only typography or four-pixel gallery gutters.",
      "**Don’t** recolour the logo, use reference screenshots as shipped assets or invent photographs, histogram values, metadata or smart-album counts.",
      "**Don’t** present missing, offline or failed observations as successful empty results.",
      "**Don’t** infer duplicate equality, original integrity or recovery from visual comparison or cached previews.",
      "**Don’t** enable original-file operations, restore or release claims through a presentation change.",
      "**Don’t** add application CSS files or generate Emotion rules for every scroll/pointer coordinate."
    ]
  }
}
